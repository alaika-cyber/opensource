// OpenSource Platform - Comprehensive Relational Schema
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductType {
  SAAS
  AI_TOOLS
  DEVELOPER_TOOLS
  MOBILE_APP
  DIGITAL_DOWNLOAD
  COURSES
  ECOMMERCE
  CONSUMER_GOODS
  BUSINESS_SERVICES
}

enum PricingModel {
  ONE_TIME
  SUBSCRIPTION_MONTHLY
  SUBSCRIPTION_ANNUAL
  USAGE_BASED
}

enum CommissionModel {
  DIRECT_SALES
  REFERRAL
  TEAM_POOL
  RECURRING
  CUSTOM
}

enum ProductListingStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TeamVisibility {
  PUBLIC
  PRIVATE
}

enum TeamStatus {
  FORMING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamMemberRole {
  LEADER
  STRATEGIST
  MARKETER
  SALES_REP
  CONTENT_CREATOR
  TECHNICAL_ADVISOR
}

enum TeamMemberStatus {
  ACTIVE
  INVITED
  PENDING_APPROVAL
  REMOVED
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum AgreementStatus {
  DRAFT
  PENDING_ACCEPTANCES
  ACTIVE
  AMENDED
  TERMINATED
  DISPUTED
}

enum AttributionMethod {
  LAST_TOUCH_LINK
  DISCOUNT_CODE
  DEAL_REGISTRATION
  HYBRID
}

enum DealRegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  PAYABLE
  PAID
  REVERSED
  DISPUTED
}

enum LedgerEntryType {
  COMMISSION_EARNED
  PLATFORM_FEE
  PAYOUT_DISTRIBUTED
  REFUND_REVERSAL
  CHARGEBACK_ADJUSTMENT
  SYSTEM_CREDIT
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  name              String
  role              Role           @default(USER)
  status            AccountStatus  @default(ACTIVE)
  emailVerified     Boolean        @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  avatarUrl         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile           ProfessionalProfile?
  organizations     Organization[]
  products          Product[]
  teamsLed          Team[]         @relation("TeamLeader")
  teamMemberships   TeamMember[]
  sentInvitations   TeamInvitation[] @relation("Inviter")
  applications      TeamApplication[]
  opportunityApplications OpportunityApplication[]
  referralLinks     ReferralLink[]
  dealRegistrations DealRegistration[]
  agreementAcceptances AgreementAcceptance[]
  commissions       CommissionEntry[]
  ledgerEntries     FinancialLedger[]
  payouts           Payout[]
  assignedTasks     TeamTask[]     @relation("TaskAssignee")
  createdTasks      TeamTask[]     @relation("TaskCreator")
  discussions       TeamDiscussion[]
  comments          TeamDiscussionComment[]
  reviewsGiven      Review[]       @relation("ReviewsGiven")
  reviewsReceived   Review[]       @relation("ReviewsReceived")
  notifications     Notification[]
  auditLogs         AdminAuditLog[]
  disputesRaised    Dispute[]      @relation("DisputesRaised")
  disputesAgainst   Dispute[]      @relation("DisputesAgainst")
  supportTickets    SupportTicket[]

  // Business Collaboration Relations
  projectMemberships     ProjectMember[]
  createdMeetings        ProjectMeeting[]
  uploadedDocuments      ProjectDocument[]
  projectBookmarks       ProjectBookmark[]
  projectDecisions       ProjectDecision[]
  projectUpdates         ProjectUpdate[]
  sentProjectInvitations ProjectInvitation[] @relation("ProjectInviter")

  @@index([email])
}

model ProfessionalProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline              String?
  bio                   String?
  skills                String[]  @default([])
  specialties           String[]  @default([])
  portfolioLinks        Json?
  languages             String[]  @default(["English"])
  timezone              String?   @default("UTC")
  country               String?
  availability          String?   @default("Part-time (10-20 hrs/wk)")
  preferredContributionTypes String[] @default([])
  verifiedSalesCents    BigInt    @default(0)
  collaborationsCount   Int       @default(0)
  averageRating         Float     @default(5.0)
  isVerified            Boolean   @default(false)
  updatedAt             DateTime  @updatedAt
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  website     String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                      String               @id @default(uuid())
  ownerId                 String
  owner                   User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId          String?
  organization            Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                    String
  slug                    String               @unique
  shortDesc               String
  description             String
  category                String
  tags                    String[]             @default([])
  productType             ProductType          @default(SAAS)
  images                  String[]             @default([])
  websiteUrl              String?
  targetAudience          String?
  priceCents              Int
  currency                String               @default("USD")
  pricingModel            PricingModel         @default(ONE_TIME)
  fulfillmentDetails      String?
  refundPolicy            String?
  commissionModel         CommissionModel      @default(DIRECT_SALES)
  commissionRateBps       Int                  @default(2000) // 20.00%
  attributionMethod       AttributionMethod    @default(LAST_TOUCH_LINK)
  attributionWindowDays   Int                  @default(60)
  recurringDurationMonths Int                  @default(0)
  approvedMarketingAssets Json?
  status                  ProductListingStatus @default(ACTIVE)
  isVerified              Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  // Business Collaboration & Execution Fields
  businessStage           String               @default("MVP") // IDEA, PROTOTYPE, MVP, EARLY_TRACTION, SCALING, ESTABLISHED
  businessGoals           String[]             @default([])
  requiredSkills          String[]             @default([])
  openPositions           String[]             @default([])
  compensationModels      String[]             @default(["COMMISSION", "REVENUE_SHARE"]) // VOLUNTARY, FIXED_FEE, MILESTONE_BASED, COMMISSION, REVENUE_SHARE, EQUITY_PROPOSAL, HYBRID
  budgetDescription       String?
  equityProposal          String?
  isConfidential          Boolean              @default(false)
  applicationDeadline     DateTime?
  visibility              String               @default("PUBLIC") // PUBLIC, PRIVATE, UNLISTED, DRAFT, ARCHIVED

  opportunities           Opportunity[]
  agreements              CommercialAgreement[]
  referralLinks           ReferralLink[]
  orders                  Order[]
  dealRegistrations       DealRegistration[]
  reviews                 Review[]

  // Business Workspace Relations
  projectMembers          ProjectMember[]
  milestones              ProjectMilestone[]
  goals                   ProjectGoal[]
  meetings                ProjectMeeting[]
  documents               ProjectDocument[]
  businessPlans           ProjectBusinessPlan[]
  leads                   ProjectLead[]
  risks                   ProjectRisk[]
  decisions               ProjectDecision[]
  updates                 ProjectUpdate[]
  bookmarks               ProjectBookmark[]
  invitations             ProjectInvitation[]
  tasks                   TeamTask[]

  @@index([slug])
  @@index([category])
  @@index([status])
}

model Opportunity {
  id            String                   @id @default(uuid())
  productId     String
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title         String
  description   String
  rolesNeeded   String[]                 @default([])
  isOpen        Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  applications  OpportunityApplication[]

  @@index([productId])
}

model OpportunityApplication {
  id              String            @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantUserId String
  applicantUser   User              @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  coverLetter     String
  proposedStrategy String?
  proposedRole    String?
  skills          String[]          @default([])
  requestedCompensation String?
  reviewNotes     String?
  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([opportunityId])
  @@index([applicantUserId])
}

model Team {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  logoUrl         String?
  description     String
  skills          String[]          @default([])
  industryFocus   String?
  leaderId        String
  leader          User              @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  visibility      TeamVisibility    @default(PUBLIC)
  status          TeamStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members         TeamMember[]
  invitations     TeamInvitation[]
  applications    TeamApplication[]
  opportunityApplications OpportunityApplication[]
  agreements      CommercialAgreement[]
  campaigns       Campaign[]
  referralLinks   ReferralLink[]
  tasks           TeamTask[]
  discussions     TeamDiscussion[]
  reviews         Review[]
  dealRegistrations DealRegistration[]
  commissions     CommissionEntry[]

  @@index([slug])
  @@index([status])
}

model TeamMember {
  id            String            @id @default(uuid())
  teamId        String
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          TeamMemberRole    @default(SALES_REP)
  allocationBps Int               @default(2000) // 20.00% of team commission pool
  status        TeamMemberStatus  @default(ACTIVE)
  joinedAt      DateTime          @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvitation {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User             @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  email       String
  role        TeamMemberRole   @default(SALES_REP)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([teamId])
  @@index([token])
}

model TeamApplication {
  id            String            @id @default(uuid())
  teamId        String
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposedRole  TeamMemberRole    @default(SALES_REP)
  message       String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([teamId])
  @@index([userId])
}

model CommercialAgreement {
  id                    String            @id @default(uuid())
  productId             String
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  teamId                String?
  team                  Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agreementVersion      Int               @default(1)
  commissionModel       CommissionModel   @default(TEAM_POOL)
  commissionPoolBps     Int               @default(2000) // 20.00% gross of qualifying sales
  allocationRulesJson   Json              // Array of { userId, memberRole, allocationBps }
  refundChargebackPolicy String           @default("Reversed proportionally within 30 days of sale.")
  recurringDurationMonths Int             @default(0)
  attributionWindowDays Int               @default(60)
  termsText             String
  checksum              String            // SHA256 of agreement terms for immutability verification
  status                AgreementStatus   @default(ACTIVE)
  compensationType      String            @default("COMMISSION") // VOLUNTARY, FIXED_FEE, MILESTONE_BASED, COMMISSION, REVENUE_SHARE, EQUITY_PROPOSAL, HYBRID
  fixedFeeCents         Int               @default(0)
  milestoneTerms        String?
  equityProposalText    String?
  equityDisclaimer      String            @default("Proposed equity terms are non-binding expressions of interest and do not constitute legal issuance of shares or securities.")
  disputeProcedure      String            @default("Platform mediation followed by binding resolution.")
  validFrom             DateTime          @default(now())
  validUntil            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  acceptances           AgreementAcceptance[]
  campaigns             Campaign[]
  commissions           CommissionEntry[]
  disputes              Dispute[]

  @@index([productId])
  @@index([teamId])
  @@index([status])
}

model AgreementAcceptance {
  id            String              @id @default(uuid())
  agreementId   String
  agreement     CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checksum      String
  ipAddress     String?
  userAgent     String?
  acceptedAt    DateTime            @default(now())

  @@unique([agreementId, userId])
  @@index([agreementId])
  @@index([userId])
}

model Campaign {
  id            String              @id @default(uuid())
  agreementId   String
  agreement     CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name          String
  targetRevenueCents BigInt         @default(1000000) // $10,000
  status        String              @default("ACTIVE")
  startDate     DateTime            @default(now())
  endDate       DateTime?
  createdAt     DateTime            @default(now())

  referralLinks ReferralLink[]

  @@index([agreementId])
  @@index([teamId])
}

model ReferralLink {
  id            String            @id @default(uuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  code          String            @unique
  targetUrl     String
  clickCount    Int               @default(0)
  createdAt     DateTime          @default(now())

  orders        Order[]

  @@index([code])
  @@index([userId])
  @@index([productId])
}

model DealRegistration {
  id                String                 @id @default(uuid())
  productId         String
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  leadName          String
  leadCompany       String
  leadEmail         String
  dealEstimatedValueCents Int              @default(0)
  status            DealRegistrationStatus @default(SUBMITTED)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  orders            Order[]

  @@index([productId])
  @@index([userId])
  @@index([leadEmail])
}

model Order {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  referralLinkId      String?
  referralLink        ReferralLink?      @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  dealRegistrationId  String?
  dealRegistration    DealRegistration?  @relation(fields: [dealRegistrationId], references: [id], onDelete: SetNull)
  customerEmail       String
  customerName        String?
  grossAmountCents    Int
  currency            String             @default("USD")
  status              OrderStatus        @default(COMPLETED)
  externalProviderRef String?            @unique
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  commissions         CommissionEntry[]
  attributionRecord   AttributionRecord?
  disputes            Dispute[]

  @@index([productId])
  @@index([status])
  @@index([orderNumber])
}

model AttributionRecord {
  id              String            @id @default(uuid())
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          AttributionMethod @default(LAST_TOUCH_LINK)
  referralCode    String?
  verifiedAt      DateTime          @default(now())
  evidenceData    Json?
}

model CommissionEntry {
  id                    String              @id @default(uuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  agreementId           String
  agreement             CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamId                String?
  team                  Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  calculationBasisCents Int
  rateBps               Int                 // Total commission rate on sale
  memberShareBps        Int                 // Member's share of pool
  grossCommissionCents  Int                 // (Basis * rateBps * memberShareBps) / 100,000,000
  platformFeeCents      Int                 // Configured platform fee (e.g., 5% of gross commission)
  netCommissionCents    Int                 // grossCommissionCents - platformFeeCents
  currency              String              @default("USD")
  status                CommissionStatus    @default(CONFIRMED)
  eligiblePayoutDate    DateTime
  reversalReason        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  ledgerEntries         FinancialLedger[]

  @@index([userId])
  @@index([teamId])
  @@index([orderId])
  @@index([status])
}

model FinancialLedger {
  id                String          @id @default(uuid())
  entryType         LedgerEntryType
  referenceId       String          // CommissionEntry.id, Order.id, or Payout.id
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  commissionEntryId String?
  commissionEntry   CommissionEntry? @relation(fields: [commissionEntryId], references: [id], onDelete: SetNull)
  payoutId          String?
  payout            Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  amountCents       Int             // Positive for credits, negative for debits/payouts
  currency          String          @default("USD")
  balanceAfterCents Int
  idempotencyKey    String          @unique
  description       String
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@index([idempotencyKey])
  @@index([entryType])
}

model Payout {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountCents     Int
  currency        String          @default("USD")
  status          PayoutStatus    @default(SCHEDULED)
  providerRef     String?
  failureReason   String?
  requestedAt     DateTime        @default(now())
  processedAt     DateTime?

  ledgerEntries   FinancialLedger[]

  @@index([userId])
  @@index([status])
}

model TeamTask {
  id                 String        @id @default(uuid())
  teamId             String?
  team               Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Product?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            User          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId         String?
  assignee           User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  priority           TaskPriority  @default(MEDIUM)
  status             TaskStatus    @default(TODO)
  dueDate            DateTime?
  department         String?
  subtasks           Json?
  labels             String[]      @default([])
  acceptanceCriteria String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([teamId])
  @@index([projectId])
  @@index([assigneeId])
}

model TeamDiscussion {
  id          String                  @id @default(uuid())
  teamId      String
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  isPinned    Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  comments    TeamDiscussionComment[]

  @@index([teamId])
}

model TeamDiscussionComment {
  id            String         @id @default(uuid())
  discussionId  String
  discussion    TeamDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime       @default(now())

  @@index([discussionId])
}

model Dispute {
  id            String              @id @default(uuid())
  orderId       String?
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  agreementId   String?
  agreement     CommercialAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  reporterId    String
  reporter      User                @relation("DisputesRaised", fields: [reporterId], references: [id], onDelete: Restrict)
  respondentId  String?
  respondent    User?               @relation("DisputesAgainst", fields: [respondentId], references: [id], onDelete: SetNull)
  reason        String
  description   String
  evidence      Json?
  status        DisputeStatus       @default(OPEN)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
}

model Review {
  id                        String    @id @default(uuid())
  authorId                  String
  author                    User      @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId              String?
  targetUser                User?     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetTeamId              String?
  targetTeam                Team?     @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)
  productId                 String?
  product                   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  collaborationAgreementId String?
  rating                    Int       @default(5)
  title                     String?
  comment                   String
  isVerifiedCollaboration   Boolean   @default(true)
  createdAt                 DateTime  @default(now())

  @@index([targetUserId])
  @@index([targetTeamId])
  @@index([productId])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String    // INVITATION, APPLICATION, SALE, COMMISSION, PAYOUT, DISPUTE, SECURITY
  linkUrl     String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

model AdminAuditLog {
  id            String    @id @default(uuid())
  adminId       String
  admin         User      @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action        String
  targetEntity  String
  targetId      String?
  detailsJson   Json?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([adminId])
  @@index([targetEntity])
}

model PlatformSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  valueJson   Json
  description String?
  updatedAt   DateTime  @updatedAt

  @@index([key])
}

model WebhookEvent {
  id            String        @id @default(uuid())
  provider      String
  eventId       String        @unique
  eventType     String
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([provider, eventId])
  @@index([status])
}

model SupportTicket {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      String        @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String        @default("MEDIUM")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("Contributor") // e.g. "Lead Strategist", "Senior Developer", "Head of Sales"
  department String   @default("General") // "Marketing", "Sales", "Engineering", "Design", "Operations", "Finance", "Research"
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE, FORMER
  joinedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectMilestone {
  id              String    @id @default(uuid())
  projectId       String
  project         Product   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  dueDate         DateTime?
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DELAYED
  progressPercent Int       @default(0)
  kpis            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
}

model ProjectGoal {
  id           String    @id @default(uuid())
  projectId    String
  project      Product   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  targetValue  String
  currentValue String
  unit         String?
  deadline     DateTime?
  status       String    @default("ON_TRACK") // ON_TRACK, AT_RISK, BEHIND, ACHIEVED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
}

model ProjectMeeting {
  id              String    @id @default(uuid())
  projectId       String
  project         Product   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int       @default(30)
  timezone        String    @default("UTC")
  meetingUrl      String?
  agenda          String?
  notes           String?
  decisions       String?
  status          String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  attendees       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([creatorId])
}

model ProjectDocument {
  id             String   @id @default(uuid())
  projectId      String
  project        Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name           String
  fileUrl        String
  fileSize       Int      @default(0)
  fileType       String   @default("document")
  category       String   @default("General") // Strategy, Marketing, Legal, Technical, Financial, Research
  isConfidential Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([uploaderId])
}

model ProjectBusinessPlan {
  id                   String   @id @default(uuid())
  projectId            String
  project              Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  executiveSummary     String
  targetMarket         String
  valueProposition     String
  revenueStrategy      String
  marketingChannels    String
  operationsRoadmap    String
  financialProjections String?
  templateName         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
}

model ProjectLead {
  id                  String   @id @default(uuid())
  projectId           String
  project             Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadName            String
  company             String
  email               String
  stage               String   @default("PROSPECT") // PROSPECT, CONTACTED, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  estimatedValueCents Int      @default(0)
  notes               String?
  assigneeId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}

model ProjectRisk {
  id             String   @id @default(uuid())
  projectId      String
  project        Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description    String
  impact         String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  probability    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  mitigationPlan String
  status         String   @default("IDENTIFIED") // IDENTIFIED, MITIGATED, ACCEPTED, CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
}

model ProjectDecision {
  id          String   @id @default(uuid())
  projectId   String
  project     Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  decision    String
  rationale   String?
  decidedById String
  decidedBy   User     @relation(fields: [decidedById], references: [id], onDelete: Cascade)
  decidedAt   DateTime @default(now())

  @@index([projectId])
  @@index([decidedById])
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  project   Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([authorId])
}

model ProjectBookmark {
  id        String   @id @default(uuid())
  projectId String
  project   Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvitation {
  id           String   @id @default(uuid())
  projectId    String
  project      Product  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterId    String
  inviter      User     @relation("ProjectInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeEmail String
  role         String
  department   String?
  status       String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([inviterId])
}
