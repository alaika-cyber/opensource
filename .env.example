# OpenSource Environment Configuration Template
# Copy this file to .env and configure with real credentials for production.

# Relational Database (Neon Postgres)
# Pooled connection URL (used for application runtime queries)
DATABASE_URL="postgresql://neondb_owner:password@ep-your-project-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct/unpooled connection URL (used for Prisma migrations and schema push)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-your-project.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_BRANCH="production"

# App & Authentication
NEXT_PUBLIC_APP_URL="https://opensource.example.com"
JWT_SECRET="replace-with-at-least-32-characters-random-secret-key"
SESSION_COOKIE_NAME="opensource_session"

# Platform Monetization Configuration
DEFAULT_PLATFORM_FEE_BPS=500  # 5.00%
MINIMUM_PAYOUT_CENTS=5000      # $50.00
DEFAULT_CURRENCY="USD"

# Email Provider Configuration (e.g. resend, sendgrid, smtp, console)
EMAIL_PROVIDER="console"
EMAIL_FROM="notifications@yourdomain.com"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Object Storage Configuration (e.g. s3, cloudflare-r2, local)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Payment Provider Configuration (Stripe Connect or marketplace-capable provider)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
